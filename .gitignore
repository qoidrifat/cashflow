node_modules

# Playwright E2E artifacts
test-results/
playwright-report/
# Arsip per-attempt stability gate (scripts/e2e-stability-gate.sh) — dibuat di
# working dir saat pengujian lokal gate, hanya dipakai upload-artifact di CI.
test-results-attempt-*/
playwright-report-attempt-*/
blob-report//
dist/
dist-ssr/
*.local

# Server credentials
server/.env
server/*.env
!server/.env.example
server/*.json
!server/package.json
!server/package-lock.json
server/*service-account*.json
server/google-agent-search-service-account.json
*.service-account.json

# Supabase CLI local state — metadata koneksi (project ref, pooler URL, org id)
supabase/.temp/

# Dev-server logs & screen recordings (artifact lokal, bisa berisi PII/stack trace)
.dev-server*.log
public/logout-success-recording*
public/recordings/

# Database lokal berisi data user nyata (transaksi, gmail logs, sesi auth)
*.db
*.db-journal

# Turso backup dump (scripts/backupTurso.mjs) — berisi PII, jangan di-commit
backups/

# Agent runtime state (scratch/session internal — bukan produk)
.bob/

# Repository curation (2026-08-04)
.agents/
.kiro/
skills-lock.json
task-list.md
public/logout-debug-viewport.png
*.tsbuildinfo

# Verifikasi visual lokal (screenshot bukti sementara)
tmp-verify/

# Benchmark live (Gemini nyata) — hasil ber-timestamp & non-deterministik
# (biaya AI + fluktuasi model), jangan di-commit sebagai artifact
# (docs/ai/benchmark-results.json = deterministik, tetap di-commit).
docs/ai/benchmark-live-results.json
