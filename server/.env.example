# ===================== CashFlow Server Configuration =====================

# Gemini API Key (WAJIB)
# Buat di: https://aistudio.google.com/apikey
# PENTING: Jangan gunakan API key dengan HTTP Referrer restriction.
#          Server-side API key harus tanpa restriction atau dengan IP restriction saja.
#          Jika API key memiliki HTTP referrer restriction, receipt scan dan email
#          extraction akan gagal dengan error "referer blocked".
GEMINI_API_KEY=your-gemini-api-key-here

# Model Gemini (default: gemini-2.5-flash)
# Model harus mendukung vision/image input untuk receipt scan
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# HTTP Referer untuk bypass API key referrer restriction (jika ada)
# Sesuaikan dengan allowed referer di Google Cloud Console API Key settings
GEMINI_HTTP_REFERER=http://localhost:5180

# Google Cloud Project ID (opsional, untuk logging)
GCP_PROJECT_ID=your-project-id

# Google Cloud region (opsional)
GCP_LOCATION=us-central1

# ===================== GOOGLE CLOUD AGENT SEARCH / GENAI APP BUILDER =====================
AGENT_SEARCH_ENABLED=false
AGENT_SEARCH_PROJECT_ID=
AGENT_SEARCH_LOCATION=global
AGENT_SEARCH_COLLECTION=default_collection
AGENT_SEARCH_ENGINE_ID=
AGENT_SEARCH_SERVING_CONFIG_ID=default_config

AGENT_SEARCH_KNOWLEDGE_DATA_STORE_ID=
AGENT_SEARCH_TRANSACTIONS_DATA_STORE_ID=
AGENT_SEARCH_GMAIL_LOGS_DATA_STORE_ID=
AGENT_SEARCH_RECEIPTS_DATA_STORE_ID=

AGENT_SEARCH_DOCS_BUCKET=
AGENT_SEARCH_DATA_BUCKET=
AGENT_SEARCH_USER_HASH_SALT=

# Service account khusus Agent Search. Jangan commit file JSON asli.
GOOGLE_APPLICATION_CREDENTIALS=./google-agent-search-service-account.json

# Supabase server-side only. Dibutuhkan untuk verify JWT dan export data user.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server port (default: 5181)
PORT=5181

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# ===================== MONITORING & OBSERVABILITY (CF-053) =====================
# Admin emails (comma-separated). Only these users can access /admin/monitoring
# and /api/admin/metrics/* endpoints. Verified via Supabase JWT email claim.
ADMIN_EMAILS=admin@example.com

# USD to IDR conversion rate for cost estimation (configurable)
USD_TO_IDR=16000

