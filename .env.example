[TEMPLATE]

# ===================== BACKEND URL (Optional - Production) =====================
VITE_FUNCTIONS_BASE_URL=

# ===================== AUTH (LOCAL DEVELOPMENT) =====================
# Frontend memanggil backend/auth LANGSUNG di base URL ini (bukan via proxy).
# WAJIB konsisten dengan server BETTER_AUTH_URL (keduanya http://localhost:5181
# di dev) — host & port yang sama untuk inisiasi OAuth DAN callback; jangan
# mencampur localhost vs 127.0.0.1 (cookie host-only berbeda → state/session
# tidak ikut). Lihat docs/auth/GOOGLE_OAUTH_LOCALHOST_TROUBLESHOOTING.md.
VITE_API_BASE_URL=http://localhost:5181

# ===================== AI SEARCH UI FLAGS =====================
VITE_AGENT_SEARCH_ENABLED=false
VITE_AI_SEARCH_ROUTE_ENABLED=true

# ===================== AI KNOWLEDGE UI FLAG (P0.14) =====================
# CashFlow AI Knowledge Assistant (grounded Q&A atas knowledge base).
# DEFAULT FALSE — aktifkan BERSAMA server GOOGLE_AGENT_PLATFORM_ENABLED=true
# HANYA setelah billing eligibility credit "Trial credit for GenAI App Builder"
# terbukti (docs/google-agent-platform/BILLING_PROOF.md status VERIFIED).
# Menampilkan item nav AI Knowledge; runtime gate tetap config server
# /api/ai/cashflow-knowledge/config (server flag adalah sumber kebenaran).
VITE_GOOGLE_AGENT_PLATFORM_ENABLED=false

# ===================== ALERT NOTIFICATION CHANNEL (Optional) =====================
# Webhook generic (Slack/Discord/opsgenie dll) — POST JSON saat rule alert TRIGGERED.
# Kosongkan untuk nonaktifkan webhook (in-app notification ke admin tetap aktif).
# Email/SMTP channel untuk alert juga tersedia via SMTP_* di bawah — aktif bila
# SMTP_HOST + SMTP_USER + SMTP_PASS lengkap di-set; penerima = ADMIN_EMAILS.
ALERT_WEBHOOK_URL=
# Cooldown antar notifikasi per rule (menit). Default 60. Jangan < 5 (risiko spam).
ALERT_COOLDOWN_MINUTES=60
# Scheduler evaluasi alert berkala (default true). false = hanya evaluasi saat admin
# membuka dashboard. Server uji (PORT 5182) otomatis nonaktif.
ALERT_SCHEDULER_ENABLED=true
# Interval evaluasi scheduler (ms). Default 60000.
ALERT_SCHEDULER_INTERVAL_MS=60000

# ===================== GMAIL REVIEW NOTIFICATION CHANNEL (Optional) =====================
# Channel eksternal untuk hasil aksi review Gmail (approve/reject/duplicate/failed)
# agar user tahu walau app tidak terbuka. Dipicu server-side dari POST
# /api/notifications (dedupeKey `gmail-review-*`). Keduanya opsional — bila kosong,
# hanya notifikasi in-app (bell icon) yang aktif.
#
# 1) WEBHOOK generic (Slack/Discord/generic) — POST JSON saat hasil review Gmail ada.
#    Fallback ke ALERT_WEBHOOK_URL bila GMAIL_WEBHOOK_URL kosong.
GMAIL_WEBHOOK_URL=
# 2) EMAIL via SMTP (nodemailer) — vendor-agnostic: Gmail SMTP, Mailgun, SendGrid,
#    Amazon SES dll. Gmail review: aktif otomatis bila SMTP_HOST di-set; kirim ke
#    email user yang melakukan aksi review. Alert monitoring: var SMTP_* yang sama
#    dipakai untuk email ke ADMIN_EMAILS (aktif hanya bila SMTP_HOST + SMTP_USER +
#    SMTP_PASS lengkap).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Pengirim email. Kosongkan untuk fallback ke SMTP_USER / no-reply@cashflow.local.
SMTP_FROM=

# ===================== GEMINI AI (Server-side ONLY) =====================
# JANGAN gunakan VITE_GEMINI_API_KEY! API key hanya di server.
# Buat file server/.env dengan: GEMINI_API_KEY=your_key_here
# ===================== NOTE =====================
# Jangan commit .env.local atau server/.env yang berisi data asli!
