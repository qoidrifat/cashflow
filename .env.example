[TEMPLATE]

# ===================== BACKEND URL (Optional - Production) =====================
VITE_FUNCTIONS_BASE_URL=

# ===================== AI SEARCH UI FLAGS =====================
VITE_AGENT_SEARCH_ENABLED=false
VITE_AI_SEARCH_ROUTE_ENABLED=true

# ===================== ALERT NOTIFICATION CHANNEL (Optional) =====================
# Webhook generic (Slack/Discord/opsgenie dll) — POST JSON saat rule alert TRIGGERED.
# Kosongkan untuk nonaktifkan webhook (in-app notification ke admin tetap aktif).
ALERT_WEBHOOK_URL=
# Cooldown antar notifikasi per rule (menit). Default 60. Jangan < 5 (risiko spam).
ALERT_COOLDOWN_MINUTES=60
# Scheduler evaluasi alert berkala (default true). false = hanya evaluasi saat admin
# membuka dashboard. Server uji (PORT 5182) otomatis nonaktif.
ALERT_SCHEDULER_ENABLED=true
# Interval evaluasi scheduler (ms). Default 60000.
ALERT_SCHEDULER_INTERVAL_MS=60000

# ===================== GEMINI AI (Server-side ONLY) =====================
# JANGAN gunakan VITE_GEMINI_API_KEY! API key hanya di server.
# Buat file server/.env dengan: GEMINI_API_KEY=your_key_here
# ===================== NOTE =====================
# Jangan commit .env.local atau server/.env yang berisi data asli!
