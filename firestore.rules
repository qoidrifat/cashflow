rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validTransaction(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['income', 'expense', 'transfer', 'refund']
        && request.resource.data.source in ['manual', 'gmail'];
    }

    function validCategory(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.color is string;
    }

    function validBudget(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.month is number
        && request.resource.data.month >= 1
        && request.resource.data.month <= 12
        && request.resource.data.year is number
        && request.resource.data.status in ['safe', 'warning', 'overbudget'];
    }

    function validRecurring(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['income', 'expense', 'transfer', 'refund']
        && request.resource.data.interval in ['daily', 'weekly', 'monthly', 'yearly']
        && request.resource.data.intervalDay is number
        && request.resource.data.startDate is string
        && request.resource.data.nextDueDate is string
        && request.resource.data.active is bool;
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserDoc(userId);

      match /transactions/{transactionId} {
        allow read, delete: if ownsUserDoc(userId);
        allow create, update: if ownsUserDoc(userId) && validTransaction(userId);
      }

      match /categories/{categoryId} {
        allow read, delete: if ownsUserDoc(userId);
        allow create, update: if ownsUserDoc(userId) && validCategory(userId);
      }

      match /budgets/{budgetId} {
        allow read, delete: if ownsUserDoc(userId);
        allow create, update: if ownsUserDoc(userId) && validBudget(userId);
      }

      match /recurring/{recurringId} {
        allow read, delete: if ownsUserDoc(userId);
        allow create, update: if ownsUserDoc(userId) && validRecurring(userId);
      }

      match /gmailSyncLogs/{logId} {
        allow read, delete: if ownsUserDoc(userId);
        allow create, update: if ownsUserDoc(userId)
          && request.resource.data.userId == userId
          && request.resource.data.messageId is string
          && request.resource.data.status in [
            'pending_review', 'approved', 'rejected',
            'auto_rejected', 'skipped', 'duplicate',
            'failed', 'retry_later', 'paused_config_error'
          ];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
