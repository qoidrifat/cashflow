{
  "name": "cashflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "npx tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "npx tsc --noEmit && node scripts/typography-lint.mjs && node scripts/check-tailwind-tokens.mjs && node scripts/check-opacity-scale.mjs",
    "lint:tokens": "node scripts/check-tailwind-tokens.mjs && node scripts/check-opacity-scale.mjs",
    "typecheck": "tsc --noEmit",
    "dev:server": "node --watch server/index.js",
    "dev:all": "node scripts/dev-all.mjs",
    "test": "npm run test:unit",
    "test:e2e": "playwright test --grep-invert \"@visual|@perf\"",
    "test:e2e:isolated": "playwright test -c playwright.e2e-local.config.mjs",
    "test:e2e:parallel": "node scripts/run-e2e-shards.mjs",
    "audit:deps": "node scripts/dependencyAudit.mjs",
    "test:e2e:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:component": "vitest run --project unit-dom",
    "test:a11y": "npm run test:e2e:a11y",
    "test:e2e:stability": "bash scripts/e2e-stability-gate.sh",
    "test:e2e:gmail": "playwright test e2e/gmail-sync.spec.ts",
    "test:e2e:gmail-review": "playwright test e2e/gmail-review-approve.spec.ts e2e/gmail-review-approve-doubleclick.spec.ts e2e/gmail-review-reject.spec.ts e2e/gmail-review-duplicate.spec.ts e2e/gmail-review-amount-missing.spec.ts",
    "test:e2e:notifications-realtime": "playwright test e2e/notifications-realtime.spec.ts",
    "test:e2e:transactions": "playwright test e2e/transactions.spec.ts",
    "test:e2e:dashboard": "playwright test e2e/dashboard.spec.ts",
    "test:e2e:agent-search": "playwright test e2e/agent-search-auth.spec.ts",
    "test:e2e:admin": "playwright test e2e/admin-metrics-auth.spec.ts",
    "test:e2e:admin-cache": "playwright test e2e/admin-cache.spec.ts",
    "test:e2e:agent-search-engagement": "playwright test e2e/agent-search-engagement.spec.ts",
    "test:e2e:monitoring-chart": "playwright test e2e/admin-monitoring-chart.spec.ts",
    "test:e2e:recommendation-panel": "playwright test e2e/admin-monitoring-recommendation.spec.ts",
    "test:e2e:feedback-rate-panel": "playwright test e2e/admin-monitoring-feedback-rate.spec.ts",
    "test:e2e:retention-panel": "playwright test e2e/admin-monitoring-retention.spec.ts",
    "test:e2e:ratelimit": "playwright test e2e/rate-limit.spec.ts e2e/rate-limit-ai-general.spec.ts",
    "test:e2e:core-pages": "playwright test e2e/core-pages.spec.ts",
    "test:e2e:categories": "playwright test e2e/categories.spec.ts",
    "test:e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e:contract": "playwright test e2e/contract/contract-check.spec.ts",
    "test:e2e:contract:ai-product": "playwright test e2e/contract/ai-product.spec.ts",
    "test:e2e:ai-dogfood": "playwright test e2e/ai-dogfood.spec.ts",
    "test:e2e:ai-conversation": "playwright test e2e/ai-conversation.spec.ts",
    "test:e2e:ai-timeline-pagination": "playwright test e2e/ai-timeline-pagination.spec.ts",
    "test:e2e:ai-detail-events": "playwright test e2e/ai-detail-events.spec.ts",
    "test:e2e:ai-status-machine": "playwright test e2e/ai-status-machine.spec.ts",
    "test:e2e:visual": "playwright test e2e/visual/visual-regression.spec.ts --update-snapshots",
    "test:e2e:visual:check": "playwright test e2e/visual/visual-regression.spec.ts",
    "test:visual": "playwright test e2e/visual/visual-regression.spec.ts",
    "test:visual:update": "playwright test e2e/visual/visual-regression.spec.ts --update-snapshots",
    "test:e2e:perf": "playwright test e2e/performance/performance.spec.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "capture:admin": "node scripts/capture-admin-panels.mjs",
    "capture:ai": "node scripts/captureAiScreenshots.mjs",
    "capture:ci": "node scripts/capture-admin-panels.mjs --ci && node scripts/captureAiScreenshots.mjs --ci",
    "verify:capture-selfheal": "node scripts/verify-capture-selfheal.mjs",
    "verify:auth-prod": "node scripts/verify-auth-prod-limiter.mjs",
    "verify:ai-dogfood": "node scripts/verify-ai-dogfood.mjs",
    "cleanup:sessions": "node scripts/cleanupExpiredSessions.mjs",
    "db:migrate": "node scripts/dbMigrate.mjs",
    "db:migrate:status": "node scripts/dbMigrateStatus.mjs",
    "db:migrate:check": "node scripts/dbMigrateCheck.mjs",
    "db:migrate:baseline": "node scripts/regenerateBaseline.mjs",
    "db:audit:gmail-duplicates": "node -- scripts/gmailDuplicateCleanup.mjs",
    "db:cleanup:gmail-duplicates": "node -- scripts/gmailDuplicateCleanup.mjs",
    "benchmark:ai": "vitest run tests/benchmark/aiQualityBenchmark.spec.ts",
    "benchmark:ai:live": "bash -c 'BENCH_LIVE=1 vitest run tests/benchmark/aiLiveBenchmark.spec.ts'",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:e2e:gmail-review-doubleclick": "playwright test e2e/gmail-review-approve-doubleclick.spec.ts",
    "test:e2e:settings": "playwright test e2e/settings.spec.ts",
    "test:e2e:privacy": "playwright test e2e/privacy.spec.ts",
    "test:e2e:not-found": "playwright test e2e/not-found.spec.ts",
    "test:e2e:profile": "playwright test e2e/profile.spec.ts"
  },
  "dependencies": {
    "@google/genai": "^2.9.0",
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.17.4",
    "@libsql/kysely-libsql": "^0.4.1",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.79.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.4",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
